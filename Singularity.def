Bootstrap: docker
From: continuumio/miniconda3

%labels
    Author Muna Berhe
    Version 1.0.0
    Description SMA Epigenomics Pipeline Container

%post
    apt-get update && apt-get install -y \
        build-essential \
        wget \
        curl \
        git \
        && apt-get clean

    conda create -n sma_epigenomics_pipeline python=3.11 -y

    conda install -n sma_epigenomics_pipeline \
        -c bioconda -c conda-forge \
        fastqc trim-galore bismark star \
        samtools subread multiqc bowtie2 \
        snakemake -y

    /opt/conda/envs/sma_epigenomics_pipeline/bin/pip install \
        snakemake-executor-plugin-slurm

    conda clean --all -y

%environment
    export PATH=/opt/conda/envs/sma_epigenomics_pipeline/bin:$PATH
    export CONDA_DEFAULT_ENV=sma_epigenomics_pipeline

%runscript
    exec "$@"
